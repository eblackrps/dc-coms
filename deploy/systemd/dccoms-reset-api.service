[Unit]
Description=DC Coms One-Time Password Reset API
After=network-online.target dccoms-synapse.service
Wants=network-online.target

[Service]
Type=simple
User=dccomsreset
Group=dccomsreset
EnvironmentFile=/etc/dccoms/dccoms-reset.env
ExecStart=/usr/bin/python3 /usr/local/libexec/dccoms-reset-api.py

Restart=on-failure
RestartSec=3

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/dccoms-reset

[Install]
WantedBy=multi-user.target

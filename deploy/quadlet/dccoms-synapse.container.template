[Unit]
Description=DC Coms Matrix Synapse
After=dccoms-postgres.service
Requires=dccoms-postgres.service

[Container]
Image=__SYNAPSE_IMAGE__
ContainerName=dccoms-synapse
Network=dccoms.network

PublishPort=127.0.0.1:8008:8008

Volume=/data/dccoms/synapse:/data:Z

Environment=SYNAPSE_CONFIG_PATH=/data/homeserver.yaml
Environment=TZ=__TIMEZONE__

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

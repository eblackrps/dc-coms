# DC Coms Community installation configuration
#
# Copy this file to:
#   deploy/install.env
#
# Then edit the values for your environment.

DC_COMS_FQDN=chat.example.com
DC_COMS_TIMEZONE=America/New_York

# Community V1 canonical paths - leave unchanged
DC_COMS_ROOT=/data/dccoms
DC_COMS_WEB_ROOT=/data/dccoms/preview
DC_COMS_CONFIG_ROOT=/etc/dccoms

DC_COMS_TLS_CERT=/etc/pki/tls/certs/dccoms.crt
DC_COMS_TLS_KEY=/etc/pki/tls/private/dccoms.key

DC_COMS_POSTGRES_DB=synapse
DC_COMS_POSTGRES_USER=synapse

DC_COMS_ADMIN_LOCALPART=admin

DC_COMS_ENABLE_REMINDER_BOT=true
DC_COMS_ENABLE_OPS_BOT=true

DC_COMS_SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.161.0
DC_COMS_POSTGRES_IMAGE=docker.io/library/postgres:17
